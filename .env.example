# Copy this file to .env and fill in your own key -- .env is gitignored and
# never committed. scripts/llm_interpreter.py loads it automatically.
OPENAI_API_KEY=sk-...

# Optional: override the model used for query interpretation (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Databricks target (profiles.yml) -- only needed to build/query against
# Unity Catalog instead of the local DuckDB file. dbt's env_var() reads real
# OS environment variables, not this file directly -- load it into the shell
# first: `set -a && source .env && set +a`, then `dbt build --target databricks`.
# DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
# DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# DATABRICKS_CATALOG=semantic_search_poc
# DATABRICKS_SCHEMA=dev
